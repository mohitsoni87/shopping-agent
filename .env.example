# Host-side value (scripts, local `uv run uvicorn`) - port 5433, matching
# docker-compose.yml's host port mapping for `db`. Containers themselves get
# DATABASE_URL overridden to db:5432 via docker-compose.yml's `environment:`
# block, so this value is never used inside Docker.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/shopping_agent
VOYAGE_API_KEY=
ANTHROPIC_API_KEY=

# Optional: LangSmith tracing for agent-api's LangGraph runs.
# Leave LANGSMITH_TRACING unset/false to disable - everything else is a no-op then.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=shopping-agent
